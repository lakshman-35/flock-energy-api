{
  "openapi": "3.0.0",
  "info": {
    "title": "Flock Energy Assignment API",
    "version": "1.0.0",
    "description": "REST API Wrapper for Urja Meter Operations Portal"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/v1/meters": {
      "get": {
        "summary": "Get all smart meters",
        "tags": [
          "Meters"
        ],
        "responses": {
          "200": {
            "description": "List of meters"
          }
        }
      }
    },
    "/api/v1/meters/{id}": {
      "get": {
        "summary": "Get a specific meter",
        "tags": [
          "Meters"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter details"
          }
        }
      }
    },
    "/api/v1/meters/{id}/consumption": {
      "get": {
        "summary": "Get meter consumption history",
        "tags": [
          "Consumption"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consumption history"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login to the Urja Portal",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}